      - "\u0E23\u0E31\u0E1A\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25\u0E2A\u0E38\u0E14\u0E1E\u0E34\u0E40\u0E28\u0E29"
      - "Obtiens des r\xE9compenses incroyables"
      - "\u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0622\u062A
        \u0645\u0630\u0647\u0644\u0629"
      - "\u0936\u093E\u0928\u0926\u093E\u0930 \u0907\u0928\u093E\u092E \u092A\u093E\u090F\u0902"
      - "Harika \xF6d\xFCller kazan"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Get awesome rewards at a special price!
      TermType: 0
      Description: 
      Languages:
      - Get awesome rewards at a special price!
      - "\uD2B9\uBCC4\uD55C \uAC00\uACA9\uC5D0 \uBA4B\uC9C4 \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC138\uC694!"
      - "\u7279\u5225\u4FA1\u683C\u3067\u7D20\u6575\u306A\u5831\u916C\u3092\u624B\u306B\u5165\u308C\u3088\u3046\uFF01"
      - Hol dir tolle Belohnungen zum Sonderpreis!
      - "\xA1Obt\xE9n incre\xEDbles recompensas a un precio especial!"
      - "Ganhe recompensas incr\xEDveis por um pre\xE7o especial!"
      - "Nh\u1EADn ph\u1EA7n th\u01B0\u1EDFng tuy\u1EC7t v\u1EDDi v\u1EDBi gi\xE1
        \u0111\u1EB7c bi\u1EC7t!"
      - "\u041F\u043E\u043B\u0443\u0447\u0430\u0439 \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435
        \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u043F\u043E \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
        \u0446\u0435\u043D\u0435!"
      - Dapatkan hadiah keren dengan harga spesial!
      - "\u0E23\u0E31\u0E1A\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25\u0E2A\u0E38\u0E14\u0E40\u0E08\u0E4B\u0E07\u0E43\u0E19\u0E23\u0E32\u0E04\u0E32\u0E1E\u0E34\u0E40\u0E28\u0E29!"
      - "Obtiens des r\xE9compenses g\xE9niales \xE0 un prix sp\xE9cial !"
      - "\u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0645\u0643\u0627\u0641\u0622\u062A
        \u0631\u0627\u0626\u0639\u0629 \u0628\u0633\u0639\u0631 \u062E\u0627\u0635!"
      - "\u0935\u093F\u0936\u0947\u0937 \u0915\u0940\u092E\u0924 \u092A\u0930 \u0936\u093E\u0928\u0926\u093E\u0930
        \u0907\u0928\u093E\u092E \u092A\u093E\u0913!"
      - "\xD6zel fiyata harika \xF6d\xFCller kazan!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Get cards from card packs and frends to complete sets!
      TermType: 0
      Description: 
      Languages:
      - Get cards from card packs and frends to complete sets!
      - "\uCE74\uB4DC \uD329\uACFC \uCE5C\uAD6C\uC5D0\uAC8C\uC11C \uCE74\uB4DC\uB97C
        \uBC1B\uC544 \uC138\uD2B8\uB97C \uC644\uC131\uD558\uC138\uC694!"
      - "\u30AB\u30FC\u30C9\u30D1\u30C3\u30AF\u3084\u53CB\u9054\u304B\u3089\u30AB\u30FC\u30C9\u3092\u3082\u3089\u3063\u3066\u30BB\u30C3\u30C8\u3092\u5B8C\u6210\u3055\u305B\u3088\u3046\uFF01"
      - "Hol dir Karten aus Packs und von Freunden, um Sets zu vervollst\xE4ndigen!"
      - "\xA1Consigue cartas de sobres y amigos para completar colecciones!"
      - Ganhe cartas de pacotes e amigos para completar conjuntos!
      - "L\u1EA5y th\u1EBB t\u1EEB g\xF3i v\xE0 b\u1EA1n b\xE8 \u0111\u1EC3 ho\xE0n
        th\xE0nh b\u1ED9 s\u01B0u t\u1EADp!"
      - "\u041F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435 \u043A\u0430\u0440\u0442\u044B
        \u0438\u0437 \u043F\u0430\u043A\u0435\u0442\u043E\u0432 \u0438 \u043E\u0442
        \u0434\u0440\u0443\u0437\u0435\u0439, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0431\u0440\u0430\u0442\u044C
        \u043D\u0430\u0431\u043E\u0440\u044B!"
      - Dapatkan kartu dari paket dan teman untuk melengkapi set!
      - "\u0E23\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E4C\u0E14\u0E08\u0E32\u0E01\u0E0B\u0E2D\u0E07\u0E41\u0E25\u0E30\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E43\u0E2B\u0E49\u0E04\u0E23\u0E1A\u0E40\u0E0B\u0E47\u0E15!"
      - "Obtenez des cartes des packs et des amis pour compl\xE9ter les sets !"
      - "\u0627\u062D\u0635\u0644 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0627\u062A
        \u0645\u0646 \u0627\u0644\u062D\u0632\u0645 \u0648\u0627\u0644\u0623\u0635\u062F\u0642\u0627\u0621
        \u0644\u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u062C\u0645\u0648\u0639\u0627\u062A!"
      - "\u092A\u0948\u0915 \u0914\u0930 \u0926\u094B\u0938\u094D\u0924\u094B\u0902
        \u0938\u0947 \u0915\u093E\u0930\u094D\u0921 \u092A\u093E\u0913 \u0914\u0930
        \u0938\u0947\u091F \u092A\u0942\u0930\u093E \u0915\u0930\u094B!"
      - "Setleri tamamlamak i\xE7in kart paketlerinden ve arkada\u015Flar\u0131ndan
        kart al!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
