      - "Y\xEAu c\u1EA7u n\xE0y \u0111\xE3 \u0111\u01B0\u1EE3c x\u1EED l\xFD r\u1ED3i"
      - "\u042D\u0442\u043E\u0442 \u0437\u0430\u043F\u0440\u043E\u0441 \u0443\u0436\u0435
        \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D"
      - Permintaan ini sudah diproses
      - "Peng \u0437\u0430\u043F\u0440\u043E\u0441 \u0E19\u0E35\u0E49\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E08\u0E31\u0E14\u0E01\u0E32\u0E23\u0E41\u0E25\u0E49\u0E27"
      - "Cette demande a d\xE9j\xE0 \xE9t\xE9 trait\xE9e"
      - "\u062A\u0645 \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0647\u0630\u0627
        \u0627\u0644\u0637\u0644\u0628 \u0628\u0627\u0644\u0641\u0639\u0644"
      - "\u0907\u0938 \u0905\u0928\u0941\u0930\u094B\u0927 \u0915\u094B \u092A\u0939\u0932\u0947
        \u0939\u0940 \u0938\u0902\u0938\u093E\u0927\u093F\u0924 \u0915\u093F\u092F\u093E
        \u091C\u093E \u091A\u0941\u0915\u093E \u0939\u0948"
      - "Bu istek zaten i\u015Flendi"
