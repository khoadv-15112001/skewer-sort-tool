      - "\u0631\u0648\u062D \u0627\u0644\u0631\u064A\u0627\u062D \u0627\u0644\u0645\u0631\u062D\u0629"
      - "\u091A\u0902\u091A\u0932 \u0935\u093E\u092F\u0941 \u0906\u0924\u094D\u092E\u093E"
      - "Oyunbaz R\xFCzgar Ruhu"
