      - "{[value]}\uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uACE0 \uB180\uB77C\uC6B4
        \uC774\uC57C\uAE30\uB97C \uC5F4\uC5B4\uBCF4\uC138\uC694!"
      - "\u30EC\u30D9\u30EB{[value]}\u3092\u30AF\u30EA\u30A2\u3057\u3066\u3001\u5F85\u3063\u3066\u3044\u308B\u7D20\u6575\u306A\u7269\u8A9E\u3092\u89E3\u653E\u3057\u3088\u3046\uFF01"
      - "Schlie\xDFe Level {[value]} ab, um spannende Geschichten freizuschalten!"
      - "\xA1Completa el nivel {[value]} para desbloquear incre\xEDbles historias
        que te esperan!"
      - "Complete o n\xEDvel {[value]} para desbloquear hist\xF3rias incr\xEDveis
        \xE0 frente!"
      - "Ho\xE0n th\xE0nh c\u1EA5p \u0111\u1ED9 {[value]} \u0111\u1EC3 m\u1EDF kh\xF3a
        nh\u1EEFng c\xE2u chuy\u1EC7n h\u1EA5p d\u1EABn ph\xEDa tr\u01B0\u1EDBc!"
      - "\u0417\u0430\u0432\u0435\u0440\u0448\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
        {[value]}, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
        \u0443\u0434\u0438\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
        \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0432\u043F\u0435\u0440\u0435\u0434\u0438!"
      - Selesaikan level {[value]} untuk membuka kisah seru di depan!
      - "\u0E1C\u0E48\u0E32\u0E19\u0E14\u0E48\u0E32\u0E19 {[value]} \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E25\u0E14\u0E25\u0E47\u0E2D\u0E01\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E23\u0E32\u0E27\u0E2A\u0E38\u0E14\u0E21\u0E2B\u0E31\u0E28\u0E08\u0E23\u0E23\u0E22\u0E4C\u0E17\u0E35\u0E48\u0E23\u0E2D\u0E2D\u0E22\u0E39\u0E48!"
      - "Termine le niveau {[value]} pour d\xE9bloquer des histoires incroyables
        \xE0 venir !"
      - "\u0623\u0643\u0645\u0644 \u0627\u0644\u0645\u0633\u062A\u0648\u0649 {[value]}
        \u0644\u0641\u062A\u062D \u0627\u0644\u0642\u0635\u0635 \u0627\u0644\u0631\u0627\u0626\u0639\u0629
        \u0627\u0644\u062A\u064A \u062A\u0646\u062A\u0638\u0631\u0643!"
      - "\u0938\u094D\u0924\u0930 {[value]} \u092A\u0942\u0930\u093E \u0915\u0930\u0947\u0902
        \u0924\u093E\u0915\u093F \u0906\u0917\u0947 \u0915\u0940 \u0930\u094B\u092E\u093E\u0902\u091A\u0915
        \u0915\u0939\u093E\u0928\u093F\u092F\u093E\u0901 \u0905\u0928\u0932\u0949\u0915
        \u0939\u094B\u0902!"
      - "{[value]} seviyesini tamamla ve seni bekleyen harika hikayelerin kilidini
        a\xE7!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win Levels
      TermType: 0
      Description: 
      Languages:
      - Win Levels
      - "\uB808\uBCA8 \uC2B9\uB9AC"
      - "\u30EC\u30D9\u30EB\u30AF\u30EA\u30A2"
      - Level gewinnen
      - Gana niveles
      - "Ven\xE7a fases"
      - "Th\u1EAFng m\xE0n"
      - "\u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0439 \u0443\u0440\u043E\u0432\u043D\u0438"
      - Menangkan level
      - "\u0E0A\u0E19\u0E30\u0E14\u0E48\u0E32\u0E19"
      - Gagne des niveaux
      - "\u0627\u0631\u0628\u062D \u0627\u0644\u0645\u0631\u0627\u062D\u0644"
      - "\u0938\u094D\u0924\u0930 \u091C\u0940\u0924\u0947\u0902"
      - Seviyeleri Kazan
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win Rewards!
      TermType: 0
      Description: 
      Languages:
      - Win Rewards!
      - "\uBCF4\uC0C1\uC744 \uD68D\uB4DD\uD558\uC138\uC694!"
      - "\u5831\u916C\u3092\u7372\u5F97\uFF01"
      - Gewinne Belohnungen!
      - "\xA1Gana recompensas!"
      - Ganhe recompensas!
      - "Nh\u1EADn ph\u1EA7n th\u01B0\u1EDFng!"
      - "\u0412\u044B\u0438\u0433\u0440\u0430\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u044B!"
      - Menangkan hadiah!
      - "\u0E23\u0E31\u0E1A\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25!"
      - "Gagnez des r\xE9compenses !"
      - "\u0627\u0631\u0628\u062D \u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062A!"
      - "\u0907\u0928\u093E\u092E \u091C\u0940\u0924\u0947\u0902!"
      - "\xD6d\xFCller Kazan!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win great prizes!
      TermType: 0
      Description: 
      Languages:
      - Win great prizes!
      - "\uBA4B\uC9C4 \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC138\uC694!"
      - "\u8C6A\u83EF\u306A\u5831\u916C\u3092\u30B2\u30C3\u30C8\u3057\u3088\u3046\uFF01"
      - Gewinne tolle Preise!
      - "\xA1Gana premios incre\xEDbles!"
      - "Ganhe pr\xEAmios incr\xEDveis!"
      - "Nh\u1EADn qu\xE0 gi\xE1 tr\u1ECB!"
      - "\u0412\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u0439 \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435
        \u043F\u0440\u0438\u0437\u044B!"
      - Menangkan hadiah besar!
      - "\u0E25\u0E38\u0E49\u0E19\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25\u0E2A\u0E38\u0E14\u0E04\u0E38\u0E49\u0E21!"
      - "Gagne de super lots\_!"
      - "\u0627\u0631\u0628\u062D \u062C\u0648\u0627\u0626\u0632 \u0631\u0627\u0626\u0639\u0629!"
      - "\u0936\u093E\u0928\u0926\u093E\u0930 \u0907\u0928\u093E\u092E \u091C\u0940\u0924\u0947\u0902!"
      - "Harika \xF6d\xFCller kazan!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win level X to unlock
      TermType: 0
      Description: 
      Languages:
      - Win level {[value]} to unlock
      - "{[value]} \uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uC5EC \uC7A0\uAE08 \uD574\uC81C"
      - "\u30EC\u30D9\u30EB{[value]}\u3092\u30AF\u30EA\u30A2\u3057\u3066\u30A2\u30F3\u30ED\u30C3\u30AF"
      - Gewinne Level {[value]}, um freizuschalten
      - Gana el nivel {[value]} para desbloquear
      - "Ven\xE7a o n\xEDvel {[value]} para desbloquear"
      - "Th\u1EAFng level {[value]} \u0111\u1EC3 m\u1EDF kh\xF3a"
      - "\u0412\u044B\u0438\u0433\u0440\u0430\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
        {[value]}, \u0447\u0442\u043E\u0431\u044B \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
      - Menangkan level {[value]} untuk membuka kunci
      - "\u0E0A\u0E19\u0E30\u0E14\u0E48\u0E32\u0E19 {[value]} \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1B\u0E25\u0E14\u0E25\u0E47\u0E2D\u0E01"
      - "Gagne le niveau {[value]} pour d\xE9bloquer"
      - "\u0627\u0631\u0628\u062D \u0627\u0644\u0645\u0633\u062A\u0648\u0649 {[value]}
        \u0644\u0641\u062A\u062D\u0647"
      - "\u0938\u094D\u0924\u0930 {[value]} \u091C\u0940\u0924\u0947\u0902 \u0905\u0928\u0932\u0949\u0915
        \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F"
      - "Seviye {[value]} kazan\u0131n, kilidi a\xE7mak i\xE7in"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win level on your first try to earn a pinata filled with surprise rewards!
      TermType: 0
      Description: 
      Languages:
      - Win level on your first try to earn a pinata filled with surprise rewards!
      - "\uCCAB \uB3C4\uC804\uC5D0\uC11C \uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uC5EC
        \uB180\uB77C\uC6B4 \uBCF4\uC0C1\uC774 \uAC00\uB4DD\uD55C \uD53C\uB0D0\uD0C0\uB97C
        \uBC1B\uC73C\uC138\uC694!"
      - "\u6700\u521D\u306E\u6311\u6226\u3067\u30EC\u30D9\u30EB\u3092\u30AF\u30EA\u30A2\u3057\u3066\u3001\u30B5\u30D7\u30E9\u30A4\u30BA\u5831\u916C\u304C\u8A70\u307E\u3063\u305F\u30D4\u30CB\u30E3\u30FC\u30BF\u3092\u624B\u306B\u5165\u308C\u3088\u3046\uFF01"
      - "Gewinne das Level beim ersten Versuch und erhalte eine Pi\xF1ata voller
        \xDCberraschungsbelohnungen!"
      - "\xA1Gana el nivel en tu primer intento para obtener una pi\xF1ata llena
        de recompensas sorpresa!"
      - "Ven\xE7a o n\xEDvel na sua primeira tentativa para ganhar uma pi\xF1ata
        cheia de recompensas surpresa!"
      - "Th\u1EAFng m\xE0n ngay l\u1EA7n ch\u01A1i \u0111\u1EA7u \u0111\u1EC3 nh\u1EADn
        pinata ch\u1EE9a \u0111\u1EA7y ph\u1EA7n th\u01B0\u1EDFng b\u1EA5t ng\u1EDD!"
      - "\u041F\u043E\u0431\u0435\u0434\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
        \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
        \u0438 \u043F\u043E\u043B\u0443\u0447\u0438 \u043F\u0438\u043D\u044C\u044F\u0442\u0443,
        \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432!"
      - "Menangkan level pada percobaan pertama untuk mendapatkan pi\xF1ata berisi
        hadiah kejutan!"
      - "\u0E0A\u0E19\u0E30\u0E14\u0E48\u0E32\u0E19\u0E15\u0E31\u0E49\u0E07\u0E41\u0E15\u0E48\u0E04\u0E23\u0E31\u0E49\u0E07\u0E41\u0E23\u0E01\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E23\u0E31\u0E1A\u0E1B\u0E35\u0E0D\u0E32\u0E15\u0E32\u0E17\u0E35\u0E48\u0E40\u0E15\u0E47\u0E21\u0E44\u0E1B\u0E14\u0E49\u0E27\u0E22\u0E02\u0E2D\u0E07\u0E23\u0E32\u0E07\u0E27\u0E31\u0E25\u0E2A\u0E38\u0E14\u0E40\u0E0B\u0E2D\u0E23\u0E4C\u0E44\u0E1E\u0E23\u0E2A\u0E4C!"
      - "Gagne le niveau d\xE8s ta premi\xE8re tentative pour recevoir une pi\xF1ata
        remplie de r\xE9compenses surprises !"
      - "\u0627\u0631\u0628\u062D \u0627\u0644\u0645\u0633\u062A\u0648\u0649 \u0645\u0646
        \u0627\u0644\u0645\u062D\u0627\u0648\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649
        \u0644\u062A\u062D\u0635\u0644 \u0639\u0644\u0649 \u0628\u064A\u0646\u064A\u0627\u062A\u0627
        \u0645\u0644\u064A\u0626\u0629 \u0628\u0627\u0644\u0645\u0643\u0627\u0641\u0622\u062A
        \u0627\u0644\u0645\u0641\u0627\u062C\u0626\u0629!"
      - "\u092A\u0939\u0932\u0947 \u092A\u094D\u0930\u092F\u093E\u0938 \u092E\u0947\u0902
        \u0938\u094D\u0924\u0930 \u091C\u0940\u0924\u0947\u0902 \u0914\u0930 \u0938\u0930\u092A\u094D\u0930\u093E\u0907\u091C\u093C
        \u0907\u0928\u093E\u092E\u094B\u0902 \u0938\u0947 \u092D\u0930\u0940 \u092A\u093F\u0928\u093E\u091F\u093E
        \u092A\u093E\u090F\u0902!"
      - "\u0130lk denemende seviyeyi kazan ve s\xFCrpriz \xF6d\xFCllerle dolu bir
        pinata kazan!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win levels without losing a life and gain extra time each level! Keep
        your winstreak!
      TermType: 0
      Description: 
      Languages:
      - Win levels without losing a life and gain extra time each level! Keep your
        winstreak!
      - "\uBAA9\uC228\uC744 \uC783\uC9C0 \uC54A\uACE0 \uB808\uBCA8\uC744 \uD074\uB9AC\uC5B4\uD558\uACE0
        \uAC01 \uB808\uBCA8\uB9C8\uB2E4 \uCD94\uAC00 \uC2DC\uAC04\uC744 \uC5BB\uC73C\uC138\uC694!
        \uC5F0\uC2B9\uC744 \uC774\uC5B4\uAC00\uC138\uC694!"
      - "\u30E9\u30A4\u30D5\u3092\u5931\u308F\u305A\u306B\u30B9\u30C6\u30FC\u30B8\u3092\u30AF\u30EA\u30A2\u3057\u3066\u5404\u30EC\u30D9\u30EB\u3067\u8FFD\u52A0\u6642\u9593\u3092\u7372\u5F97\uFF01\u9023\u52DD\u3092\u7D9A\u3051\u307E\u3057\u3087\u3046\uFF01"
      - "Gewinne Level, ohne ein Leben zu verlieren, und gewinne mit jedem Level
        zus\xE4tzliche Zeit! Behalte deine Siegesserie!"
      - "\xA1Gana niveles sin perder una vida y gana tiempo extra en cada nivel!
        \xA1Mant\xE9n tu racha de victorias!"
      - "Ven\xE7a n\xEDveis sem perder uma vida e ganhe tempo extra a cada n\xEDvel!
        Mantenha sua sequ\xEAncia de vit\xF3rias!"
      - "Th\u1EAFng li\xEAn ti\u1EBFp kh\xF4ng m\u1EA5t m\u1EA1ng \u0111\u1EC3 nh\u1EADn
        th\xEAm th\u1EDDi gian m\u1ED7i m\xE0n! H\xE3y gi\u1EEF chu\u1ED7i th\u1EAFng
        c\u1EE7a b\u1EA1n!"
      - "\u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0439\u0442\u0435 \u0432 \u0443\u0440\u043E\u0432\u043D\u044F\u0445,
        \u043D\u0435 \u0442\u0435\u0440\u044F\u044F \u0436\u0438\u0437\u043D\u044C,
        \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
        \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
        \u0443\u0440\u043E\u0432\u043D\u0435! \u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
        \u0441\u0435\u0440\u0438\u044E \u043F\u043E\u0431\u0435\u0434!"
      - "Menang tanpa kehilangan nyawa dan dapatkan waktu ekstra di tiap level! Jaga
        win\u2011streak\u2011mu!"
      - "\u0E0A\u0E19\u0E30\u0E14\u0E48\u0E32\u0E19\u0E42\u0E14\u0E22\u0E44\u0E21\u0E48\u0E40\u0E2A\u0E35\u0E22\u0E0A\u0E35\u0E27\u0E34\u0E15\u0E41\u0E25\u0E30\u0E23\u0E31\u0E1A\u0E40\u0E27\u0E25\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E17\u0E38\u0E01\u0E14\u0E48\u0E32\u0E19!
        \u0E23\u0E31\u0E01\u0E29\u0E32\u0E2A\u0E16\u0E34\u0E15\u0E34\u0E0A\u0E19\u0E30\u0E15\u0E48\u0E2D\u0E40\u0E19\u0E37\u0E48\u0E2D\u0E07\u0E44\u0E27\u0E49!"
      - "Gagne des niveaux sans perdre de vie et obtiens du temps en plus \xE0 chaque
        niveau\_! Garde ta s\xE9rie de victoires\_!"
      - "\u0627\u0641\u0632 \u0628\u0627\u0644\u0645\u0631\u0627\u062D\u0644 \u062F\u0648\u0646
        \u062E\u0633\u0627\u0631\u0629 \u062D\u064A\u0627\u0629 \u0644\u062A\u062D\u0635\u0644
        \u0639\u0644\u0649 \u0648\u0642\u062A \u0625\u0636\u0627\u0641\u064A \u0641\u064A
        \u0643\u0644 \u0645\u0631\u062D\u0644\u0629! \u062D\u0627\u0641\u0638 \u0639\u0644\u0649
        \u0633\u0644\u0633\u0644\u0629 \u0627\u0646\u062A\u0635\u0627\u0631\u0627\u062A\u0643!"
      - "\u092C\u093F\u0928\u093E \u0932\u093E\u0907\u092B \u0917\u0902\u0935\u093E\u090F
        \u0932\u0947\u0935\u0932 \u091C\u0940\u0924\u0947\u0902 \u0914\u0930 \u0939\u0930
        \u0932\u0947\u0935\u0932 \u092A\u0930 \u0905\u0924\u093F\u0930\u093F\u0915\u094D\u0924
        \u0938\u092E\u092F \u092A\u093E\u090F\u0902! \u0905\u092A\u0928\u0940 \u0935\u093F\u0928\u2011\u0938\u094D\u091F\u094D\u0930\u093F\u0915
        \u092C\u0928\u093E\u090F \u0930\u0916\u0947\u0902!"
      - "Can kaybetmeden seviyeleri kazan ve her seviyede ekstra s\xFCre elde et!
        Kazanma serini koru!"
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win streak
      TermType: 0
      Description: 
      Languages:
      - Win streak
      - "\uC5F0\uC2B9"
      - "\u9023\u52DD"
      - Siegesserie
      - Racha de victorias
      - "Sequ\xEAncia de vit\xF3rias"
      - "Chu\u1ED7i th\u1EAFng"
      - "\u0421\u0435\u0440\u0438\u044F \u043F\u043E\u0431\u0435\u0434"
      - Rangkaian Menang
      - "\u0E0A\u0E19\u0E30\u0E15\u0E48\u0E2D\u0E40\u0E19\u0E37\u0E48\u0E2D\u0E07"
      - "S\xE9rie de victoires"
      - "\u0633\u0644\u0633\u0644\u0629 \u0627\u0646\u062A\u0635\u0627\u0631\u0627\u062A"
      - "\u091C\u0940\u0924 \u0915\u0940 \u0932\u0921\u093C\u0940"
      - Kazanma Serisi
      Flags: 0000000000000000000000000000
      Languages_Touch: []
    - Term: Win your share of 5000 coins
      TermType: 0
      Description: 
