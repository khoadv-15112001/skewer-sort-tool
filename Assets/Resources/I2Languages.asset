      - "B\u1EA1n s\u1EBD m\u1EA5t <color={[color]}>{[X]}</color> v\xE0 <color={[color]}>{[Y]}</color>!"
      - "\u0422\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0448\u044C <color={[color]}>{[X]}</color>
        \u0438 <color={[color]}>{[Y]}</color>!"
