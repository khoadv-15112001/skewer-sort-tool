    characterSequence: "Korean\r\n\uBB34\uC791\uC704 \uBD80\uC2A4\uD130\r\n5\uAC1C
      \uB300\uC2E0 {[VALUE]}\uAC1C\uC758 \uBAA9\uC228\r\n\uD65C\uC131\uD654\r\n<color=#B73333>{[VALUE]}s</color>\uCD08
      \uCD94\uAC00\uD558\uC5EC \uACC4\uC18D\uD558\uAE30\r\n\uC2DC\uAC04 \uCD94\uAC00\r\n\uB180\uB77C\uC6B4
      \uBC88\uB4E4\r\n\uB180\uB77C\uC6B4 \uD504\uB9AC\uBBF8\uC5C4 \uBC88\uB4E4\r\n\uB180\uB77C\uC6B4
      \uD504\uB85C \uBC88\uB4E4\r\n\"\uC601\uC5ED \n {[VALUE]}\"\r\n\uC9C0\uC5ED\r\n\uC544\uBC14\uD0C0\r\n\uB3CC\uC544\uC628
      \uAC1C\uD559\r\n\uBC30\uC9C0\r\n\uB808\uBCA8\uB4E4\uC744 \uD074\uB9AC\uC5B4!\r\n\uC2A4\uD14C\uC774\uC9C0\uB97C
      \uAE68\uC11C \uC800\uAE08\uD1B5\uC744 \uCC44\uC6CC\uBCF4\uC138\uC694!\r\n3\uBC88
      \uC2E4\uD328\uD558\uC9C0 \uC54A\uACE0 \uB808\uBCA8\uC744 \uD074\uB9AC\uC5B4\uD574
      \uB2E8\uACC4\uB97C \uC644\uC131\uD558\uC138\uC694!\r\n\uADF8\uB0E5 \uD2B9\uAC00\r\n\uCD5C\uACE0
      \uD61C\uD0DD\r\n\uBE14\uB85C\uC6B0 \uD1A0\uCE58\r\nKO_JALNANGOTHICTTF SDF Blue
      Outline Shadow\r\nKO_JALNANGOTHICTTF SDF Blue Outline\r\n\uD3ED\uD0C4\r\n\uD3ED\uD0C4
      \uD3ED\uBC1C\r\n\uD3ED\uD0C4!\r\n\uBD80\uC2A4\uD130\r\n\uBD80\uC2A4\uD130 \uC7A0\uAE08
      \uD574\uC81C!\r\n\uC5BC\uC5B4\uBD99\uC740 \uBB3C\uCCB4\uB97C \uAE68\uC138\uC694!\r\nKO_JALNANGOTHICTTF
      SDF Brown Outline Shadow\r\n\uAD6C\uB9E4\r\n\uCEA0\uD551 \uC5EC\uD589\r\n\uBC1B\uAE30\r\n\uAC01
      \uC81C\uC548\uC744 \uC218\uB77D\uD558\uC5EC \uBB34\uB8CC \uBCF4\uC0C1\uC744
      \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694!\r\n\uC218\uB839\uAE4C\uC9C0: {[TIME]}\r\n\uD68D\uB4DD
      \uC644\uB8CC!\r\n\uAD11\uACE0\uB97C \uC2DC\uCCAD\uD558\uACE0 \uBE48 \uC7C1\uBC18\uC744
      \uC7A0\uAE08 \uD574\uC81C\uD558\uC138\uC694!\r\n\uD574\uC548\uAC00 \uB808\uC2A4\uD1A0\uB791\r\n\uBCC4\uC744
      \uBAA8\uC544 <color=#F9D23B>\uBCC4 \uC0C1\uC790</color>\uB97C \uC5F4\uACE0
      \uBCF4\uC0C1\uC744 \uBC1B\uC73C\uC138\uC694!\r\n\uD669\uAE08 \uC18C\uC2DC\uC9C0\uB97C
      \uBAA8\uC544 \uBCF4\uC0C1\uC744 \uC5F4\uACE0 \uBC1B\uC73C\uC138\uC694!\r\n\uD2B9\uBCC4\uD55C
      \uC544\uC774\uD15C\uC744 \uBAA8\uC73C\uC138\uC694\r\n\uBCC4\uC744 \uBAA8\uC544
      \uBCF4\uC0C1\uC744 \uC5F4\uC5B4\uBCF4\uC138\uC694\r\n\uCEEC\uB809\uC158\r\n\uCF64\uBCF4
      {[VALUE]}\r\n\uB2E4\uC74C \uB0A0 \uB2E4\uC2DC \uC640\uC11C \uBC1B\uC73C\uC138\uC694!\r\n{[VALUE]}
      \uD6C4\uC5D0 \uB3CC\uC544\uC624\uAE30\r\n\uACE7 \uCD9C\uC2DC \uC608\uC815\r\n\uCCAB
      \uC2DC\uB3C4\uC5D0\uC11C \uB808\uBCA8\uC744 \uC644\uB8CC\uD558\uACE0 \uB2E4\uC74C
      \uB808\uBCA8\uC5D0\uC11C \uBCF4\uB108\uC2A4\uB97C \uBC1B\uC73C\uC138\uC694!\r\n\uC644\uB8CC!\r\n\uD655\uC778\r\n\uB300\uD68C\r\n\uACC4\uC18D\uD558\uB2E4\r\n\uCEE8\uBCA0\uC774\uC5B4\r\n\uB370\uC77C\uB9AC
      \uC120\uBB3C\r\n\uBCF4\uC0C1\r\n{[VALUE]}\uC77C\r\n{VALUE}\uC77C\r\n\uACC4\uC18D\uD558\uC2DC\uACA0\uC5B4\uC694?\r\n\uAC74\uB108\uB6F0\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?\r\n\uD3ED\uD0C4\uC774
      \uD3ED\uBC1C\uD558\uC9C0 \uC54A\uB3C4\uB85D \uD558\uC138\uC694!\r\n\uB354\uBE14
      \uC2A4\uD0C0\r\n\uB2E4\uC74C \uB77C\uC6B4\uB4DC\uC5D0\uC11C \uBCC4 2\uBC30!\r\n\uC904
      \uB0B4\uB9AC\uAE30\r\n\uD504\uB85C\uD544 \uD3B8\uC9D1\r\n\uBE48 \uC7C1\uBC18\r\n\uB05D\uC5C6\uB294
      \uBCF4\uBB3C\r\n2\uBC88 \uC548\uC5D0 \uC544\uC774\uD15C\uC744 \uC815\uB9AC\uD558\uC9C0
      \uC54A\uC73C\uBA74, \uC5BC\uC74C\uC774 \uB450\uAEBC\uC6CC\uC9D1\uB2C8\uB2E4.\r\n\uC800\uAE08\uD1B5\uC744
      \uCC44\uC6B0\uACE0 \uB808\uBCA8\uC744 \uD074\uB9AC\uC5B4\uD574 \uB354 \uB9CE\uC740
      \uCF54\uC778\uC744 \uBAA8\uC73C\uC138\uC694!\r\n\uC2DC\uAC04\uC774 \uB05D\uB098\uAE30
      \uC804\uC5D0 \uACE0\uAC1D \uC8FC\uBB38\uC744 \uC644\uB8CC\uD558\uC138\uC694\r\n\uC2DC\uAC04\uC774
      \uB2E4 \uB418\uAE30 \uC804\uC5D0 \uACE0\uAC1D\uC758 \uC8FC\uBB38\uC744 \uC644\uB8CC\uD558\uC138\uC694\r\n\uC644\uB8CC\r\nKO_JALNANGOTHICTTF
      SDF Material\r\n\uD504\uB808\uC784\r\n\uBB34\uB8CC\r\n\uBB34\uB8CC \uC0DD\uBA85
      1\uAC1C\r\n\uC5BC\uAE30\r\n10\uCD08 \uB3D9\uC548 \uC5BC\uB9AC\uAE30!\r\n\uC2DC\uAC04\uC744
      20\uCD08 \uB3D9\uC548 \uBA48\uCD94\uAE30\r\n\uCE5C\uAD6C\r\n\uC5BC\uC5B4\uC788\uB294
      \uC544\uC774\uD15C\uC740 \uC6C0\uC9C1\uC77C \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uAC19\uC740 \uC7C1\uBC18\uC5D0 3\uAC1C\uB97C \uC815\uB9AC\uD574 \uB179\uC774\uC138\uC694!\r\n\uAC00\uB4DD
