      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0443\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u0443!\r\n\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437: {[TIME]}\r\n\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043E\r\n\u041F\u043E\u043B\u0443\u0447\u0435\u043D\u043E!\r\n\u0421\u0443\u043F
      \u0438\u0437 \u043C\u043E\u043B\u043B\u044E\u0441\u043A\u043E\u0432\r\n\u0423\u0431\u0435\u0440\u0438
      2/3 \u0432\u0441\u0435\u0445 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u041E\u043A\u0442\u043E\u0428\u0435\u0444 \u0443\u0448\u0451\u043B.\r\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443 \u0438 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0443\u0441\u0442\u043E\u0439 \u043B\u043E\u0442\u043E\u043A!\r\n\u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F\r\n\u0421\u043E-\u043B\u0438\u0434\u0435\u0440\r\n\u041F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0439
      \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\r\n\u041A\u043E\u043A\u043E\u0441\u043E\u0432\u044B\u0439
      \u043D\u0430\u043F\u0438\u0442\u043E\u043A\r\n\u041A\u043E\u043A\u043E\u0441\u043E\u0432\u0430\u044F
      \u0441\u043C\u0435\u0441\u044C\r\n\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B\r\n\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435
      \u0437\u0432\u0435\u0437\u0434\u0443, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      <color=#F9D23B>\u0421\u0443\u043D\u0434\u0443\u043A \u0437\u0432\u0451\u0437\u0434</color>
      \u0438 \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443!\r\n\u0421\u043E\u0431\u0435\u0440\u0438
      \u043E\u0432\u043E\u0449\u0438\r\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u043F\u0430\u043A\u0435\u0442\u044B \u043A\u0430\u0440\u0442 \u0438\u0437
      \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0445 \u0441\u043E\u0431\u044B\u0442\u0438\u0439
      \u0438 \u0441\u0443\u043D\u0434\u0443\u043A\u043E\u0432!\r\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      <color=#F9D23B>\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u0441\u043E\u0441\u0438\u0441\u043A\u0438</color>,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0438
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u044B!\r\n\u0421\u043E\u0431\u0435\u0440\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u044B\u043A\u0432, \u0447\u0435\u043C
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0438\u0433\u0440\u043E\u043A\u0438\r\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439
      \u0442\u044B\u043A\u0432\u044B \u0432 \u043C\u0438\u043D\u0438-\u0438\u0433\u0440\u0430\u0445
      \u0438 \u0441\u043E\u0440\u0435\u0432\u043D\u0443\u0439\u0441\u044F \u0441
      \u0434\u0440\u0443\u0433\u0438\u043C\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0432\u044B\u0438\u0433\u0440\u0430\u0442\u044C \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B!\r\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u043E\u0441\u043E\u0431\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B\r\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439\u0442\u0435
      \u0437\u0432\u0435\u0437\u0434\u044B, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0435\u0433\u043E \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B\r\n\u041A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044F\r\n\u041A\u043E\u043C\u0431\u043E
      {[VALUE]}\r\n\u041C\u0430\u0441\u0442\u0435\u0440 \u043A\u043E\u043C\u0431\u043E\r\n\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0431\u0440\u0430\u0442\u044C \u044D\u0442\u043E!\r\n\u0412\u0435\u0440\u043D\u0438\u0441\u044C
      \u0447\u0435\u0440\u0435\u0437 {[VALUE]}\r\n\u0421\u043A\u043E\u0440\u043E\r\n\u0417\u0430\u0432\u0435\u0440\u0448\u0438
      \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u044E \u0433\u0440\u0438\u043B\u044F!\r\n\u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
      \u0443\u0440\u043E\u0432\u043D\u0438 \u0441 \u043F\u0435\u0440\u0432\u043E\u0439
      \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435
      \u0431\u043E\u043D\u0443\u0441 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435!\r\n\u0412\u044B\u043F\u043E\u043B\u043D\u0438
      \u044D\u0442\u043E \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0435\u0440\u0435\u0439\u0442\u0438 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u043E\u0442\u0440\u044F\u0441\u0430\u044E\u0449\u0438\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B!\r\n\u0412\u044B\u043F\u043E\u043B\u043D\u0438
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u044B\r\n\u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E!\r\n\u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E!\r\n\u041F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C\r\n\u0421\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0435\r\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C\r\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0411\u0415\u0421\u041F\u041B\u0410\u0422\u041D\u041E!\r\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438
      \u0441 <color=#B73333>\u0435\u0449\u0451 2 \u0442\u0430\u0440\u0435\u043B\u043A\u0430\u043C\u0438</color>!\r\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438
      \u0441 <color=#B73333>\u0435\u0449\u0451 2 \u043F\u043E\u0434\u043D\u043E\u0441\u0430\u043C\u0438</color>!\r\n\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C?\r\n\u041A\u043E\u043D\u0432\u0435\u0439\u0435\u0440\r\n\u041A\u043E\u0440\u043D\u0434\u043E\u0433\r\n\u041A\u043E\u0441\u043C\u043E\r\n\u041A\u0440\u0435\u043A\u0435\u0440\r\n\u0421\u043E\u0437\u0434\u0430\u0442\u044C\r\n\u0421\u043E\u0437\u0434\u0430\u0439
      \u043A\u043E\u043C\u0431\u043E\r\n\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C!\r\n\u0421\u043E\u0437\u0434\u0430\u043D\u0438\u0435
      \u0443\u0441\u043F\u0435\u0448\u043D\u043E!\r\n\u041A\u0440\u0435\u043C-\u0431\u0440\u044E\u043B\u0435\r\n\u0421\u0442\u043E\u043B\u043E\u0432\u044B\u0435
      \u043F\u0440\u0438\u0431\u043E\u0440\u044B\r\n\u0415\u0416\u0415\u0414\u041D\u0415\u0412\u041D\u042B\u0419
      \u041F\u041E\u0414\u0410\u0420\u041E\u041A\r\n\u0414\u043D\u0435\u0432\u043D\u043E\u0439
      \u043B\u0438\u043C\u0438\u0442:\r\n\u0415\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u043E\u0435
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435\r\n\u0415\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0430\u044F
      \u043D\u0430\u0433\u0440\u0430\u0434\u0430\r\n\u0414\u0430\u043D\u0433\u043E\r\n\u0414\u0435\u043D\u044C
      {[VALUE]}\r\n\u0414\u0435\u043D\u044C {VALUE}\r\n\u041F\u043E\u043D\u0438\u0437\u0438\u0442\u044C\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435\r\n\u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E!\r\n\u0414\u0435\u0441\u0435\u0440\u0442\u044B\r\n\u0425\u043E\u0442\u0438\u0442\u0435
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C?\r\n\u0425\u043E\u0442\u0438\u0442\u0435
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C?\r\n\u041D\u0435
      \u0434\u0430\u0439\u0442\u0435 \u0431\u043E\u043C\u0431\u0435 \u0412\u0417\u041E\u0420\u0412\u0410\u0422\u042C\u0421\u042F!\r\n\u0414\u0432\u043E\u0439\u043D\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430\r\n\u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0440\u0430\u0443\u043D\u0434\u0435 \u2014 \u0434\u0432\u043E\u0439\u043D\u044B\u0435
      \u0437\u0432\u0435\u0437\u0434\u044B!\r\n\u0414\u0432\u043E\u0439\u043D\u0430\u044F
      \u0441\u043E\u0441\u0438\u0441\u043A\u0430 \u2014 \u0434\u0432\u043E\u0439\u043D\u043E\u0435
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435!\r\n\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u043B\u0438\u043D\u0438\u044E\r\n\u041A\u0430\u0436\u0434\u0430\u044F \u0435\u0434\u0438\u043D\u0438\u0446\u0430
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0434\u0430\u0451\u0442 \u043E\u0434\u0438\u043D
      \u0445\u043E\u0434! \u0422\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E, \u0438\u0433\u0440\u0430\u044F
      \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0443\u0440\u043E\u0432\u043D\u0438!\r\n\u041F\u043E\u043B\u0443\u0447\u0430\u0439
      \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435 \u043D\u0430\u0433\u0440\u0430\u0434\u044B\r\n\u041F\u043E\u043B\u0443\u0447\u0430\u0439
      \u0432 2 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
      \u043C\u0438\u0441\u0441\u0438\u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u043F\u043E\u0431\u0435\u0434\u0443\r\n\u0420\u0435\u0434\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C\r\n\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0444\u0438\u043B\u044C\r\n\u0423\u0441\u0442\u0440\u0430\u043D\u0438
      \u041E\u043A\u0442\u043E\u043F\u043E\u0432\u0430\u0440\u0430 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E!\r\n\u041F\u0443\u0441\u0442\u043E\u0439
      \u043B\u043E\u0442\u043E\u043A\r\n\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437:\r\n\u0411\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B\u0435
      \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\r\n\u0412\u0432\u0435\u0434\u0438\u0442\u0435
      \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\r\n\u0412\u0432\u0435\u0434\u0438\u0442\u0435
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\r\n\u041F\u043E\u0434\u0430\u0440\u043E\u043A
      \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044F\r\n\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
      \u0436\u0438\u0437\u043D\u0438\r\n\u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u0435
      \u043D\u0430\u0433\u0440\u0430\u0434\u044B\r\n\u0415\u0441\u043B\u0438 \u043D\u0435
      \u0440\u0430\u0441\u0441\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0437\u0430 2 \u0445\u043E\u0434\u0430,
      \u043B\u0451\u0434 \u0441\u0442\u0430\u043D\u0435\u0442 \u0442\u043E\u043B\u0449\u0435.\r\n\u0424\u0430\u043D-\u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\r\n\u041A\u0440\u0443\u0438\u0437
      \u0441 \u043F\u0438\u0440\u0448\u0435\u0441\u0442\u0432\u043E\u043C\r\n\u0417\u0430\u043F\u043E\u043B\u043D\u0438
      \u043F\u043E\u043B\u043E\u0441\u0443\r\n\u041D\u0430\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435
      \u043A\u043E\u043F\u0438\u043B\u043A\u0443 \u0438 \u043A\u043E\u043F\u0438\u0442\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442, \u043F\u0440\u043E\u0445\u043E\u0434\u044F
      \u0443\u0440\u043E\u0432\u043D\u0438!\r\n\u041F\u043E\u0438\u0441\u043A \u0438\u0433\u0440\u043E\u043A\u043E\u0432
