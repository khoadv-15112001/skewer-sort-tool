      \u0438\u0437 \u044F\u0433\u043D\u0435\u043D\u043A\u0430\r\n\u042F\u0437\u044B\u043A\r\n\u041B\u0438\u0434\u0435\u0440\r\n\u0422\u0430\u0431\u043B\u0438\u0446\u0430
      \u043B\u0438\u0434\u0435\u0440\u043E\u0432\r\n\u041B\u0438\u0433\u0430\r\n\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C\r\n\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443\r\n\u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440\r\n\u041B\u0435\u043D\u0433 \u0421\u0430\u0430\u043F\r\n\u041C\u0435\u043D\u044C\u0448\u0435
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439!\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 <color=#A4313C>\u0413\u0430\u0437\u043E\u0432\u0430\u044F
      \u0433\u043E\u0440\u0435\u043B\u043A\u0430</color>!\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 <color=#A4313C>\u0417\u0430\u043C\u043E\u0440\u043E\u0437\u043A\u0430</color>!\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 <color=#A4313C>\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0439
      \u043A\u043B\u044E\u0447</color>!\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 <color=#A4313C>\u041F\u0435\u0440\u0435\u043C\u0435\u0448\u0430\u0442\u044C</color>!\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 <color=#A4313C>\u041B\u043E\u043F\u0430\u0442\u043A\u0430</color>!\r\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C
      {[LEVEL]}\r\n\u0421\u0443\u043D\u0434\u0443\u043A \u0443\u0440\u043E\u0432\u043D\u044F\r\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C
      \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D!\r\n\u0423\u0440\u043E\u0432\u0435\u043D\u044C\r\n\u0423\u0440\u043E\u0432\u043D\u0438\r\n\u041B\u043E\u0442\u043E\u043A
      \u0441 \u043A\u0440\u044B\u0448\u043A\u043E\u0439\r\n\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u043D\u0430\u0431\u043E\u0440\r\n\u0412\u043A\u0443\u0441 \u0433\u0440\u0438\u043B\u044F\r\n\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430
      \u043D\u0435 \u0443\u0434\u0430\u043B\u0430\u0441\u044C! \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435
      \u043F\u043E\u0437\u0436\u0435.\r\n\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430...\r\n\u041E\u043Ca\u0440\r\n\u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\r\n\u0417\u0430\u043C\u043E\u043A
      \u0438 \u043A\u043B\u044E\u0447\r\n\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443\r\n\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043B\u043E\u0442\u043E\u043A\r\n\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043B\u043E\u0442\u043E\u043A\r\n\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F\r\n\u041C\u0430\u043A\u0430\u0440\u043E\u043D\r\n\u0412\u043E\u043B\u0448\u0435\u0431\u043D\u044B\u0439
      \u043A\u043B\u044E\u0447\r\n\u041C\u0430\u0433\u043D\u0438\u0442\r\n\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439
      \u0441\u0435\u0440\u0438\u044E\r\n\u041C\u0430\u043D\u0434\u0443\r\n\u041C\u0430\u043D\u0433\u043E\r\n\u041C\u0430\u0441\u0442\u0435\u0440\u0448\u0435\u0444\r\n\u0421\u043E\u0435\u0434\u0438\u043D\u0438
      3 <color=red>\u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0435 \u0448\u0430\u043C\u043F\u0443\u0440\u044B</color>,
      \u0447\u0442\u043E\u0431\u044B \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0437\u0430\u043A\u0430\u0437!\r\n\u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      1 \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C\r\n\u0421\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435\r\n\u041C\u0438\u0430\u043D\u0433
      \u041A\u0445\u0430\u043C\r\n\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435-\u0432\u0435\u0445\u0430\r\n\u041C\u0438\u043D\u0438\u2011\u043D\u0430\u0431\u043E\u0440\r\n\u041C\u0438\u043D\u0438-\u043F\u0435\u0447\u044C\r\n\u041C\u0438\u043D\u0438\u2011\u043B\u043E\u0442\u043E\u043A\r\n\u041C\u0438\u043D\u0438\u2011\u043B\u043E\u0442\u043A\u0438
      \u0432\u043C\u0435\u0449\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442\r\n\u041C\u0438\u0441\u043E-\u0441\u0443\u043F\r\n\u041F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u043A\u0430\u0437\r\n\u0423\u0441\u0438\u043B\u0435\u043D\u0438\u0435
      \u043C\u0438\u0441\u0441\u0438\u0438\r\n\u0420\u0435\u0436\u0438\u043C \u0437\u0430\u043A\u0430\u0437\u0430\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u0431\u0443\u0441\u0442\u0435\u0440\u043E\u0432\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439!\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0439!\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u0442\u0430\u0440\u0435\u043B\u043E\u043A!\r\n\u0415\u0449\u0451 \u043F\u0440\u0435\u0434\u0431\u0443\u0441\u0442\u0435\u0440\u043E\u0432\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u043F\u043E\u0434\u043D\u043E\u0441\u043E\u0432!\r\n\u0421\u0442\u0443\u043F\u043A\u0430\r\n\u041C\u0443\u0437\u044B\u043A\u0430\r\n\u041C\u043E\u044F
      \u043A\u043E\u043C\u0430\u043D\u0434\u0430\r\n\u0418\u043C\u044F \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E!\r\n\u041D\u043E\u0432\u044B\u0439\r\n\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u0430
      \u043D\u043E\u0432\u0430\u044F \u0432\u0435\u0440\u0441\u0438\u044F \u0438\u0433\u0440\u044B.
      \u041E\u0431\u043D\u043E\u0432\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0441\u043B\u0430\u0434\u0438\u0442\u044C\u0441\u044F \u0435\u044E!\r\n\u041D\u043E\u0432\u044B\u0439
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D!\r\n\u041D\u043E\u0432\u044B\u0439
      \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C \u0440\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D!\r\n\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0436\u0438\u0437\u043D\u044C \u0447\u0435\u0440\u0435\u0437:\r\n\u041A\u043E\u0448\u043C\u0430\u0440\u043D\u043E\r\n\u041D\u0435\u0442\r\n\u0411\u0435\u0437
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B\r\n\u0411\u0435\u0437 \u0440\u0435\u043A\u043B\u0430\u043C\u044B,
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430\r\n\u0411\u0435\u0437
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435\r\n\u041D\u0435\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u044B\r\n\u0411\u0435\u0437
      \u0440\u0435\u043A\u043B\u0430\u043C\u044B, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435\r\n\u0416\u0438\u0437\u043D\u0435\u0439
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C!\r\n\u0411\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0439! \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u0437\u0430\u0432\u0442\u0440\u0430!\r\n\u0412\u0438\u0434\u0435\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E!\r\n\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438!\r\n\u041D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u043C\u043E\u043D\u0435\u0442!\r\n\"\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438?\n \u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C!\"\r\n\u0423\u0432\u0435\u0434\u043E\u043C\u043B\u0435\u043D\u0438\u0435:\r\n\u041E\u043A\u0442\u043E\u043F\u043E\u0432\u0430\u0440\r\n\u041E\u043A\u0442\u043E\u043F\u043E\u0432\u0430\u0440
      \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0445\u043E\u0434\u0430 \u0438
      \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u0433\u0440\u0438\u043B\u044C,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u044F\u0435\u0442\u0441\u044F\r\n\u041E\u043A\u0442\u043E\u043F\u043E\u0432\u0430\u0440!\r\n\u041E\u0441\u044C\u043C\u0438\u043D\u043E\u0433\r\n\u0412\u044B\u043A\u043B.\r\n\u041E,
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A!\r\n\u041E\u043C\u0430\u043A\u0430\u0441\u0435\r\n\u0412\u043A\u043B.\r\n\u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u043F\u043E\u0434\u0431\u043E\u0440\u0430
      \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u044B,
      \u043B\u043E\u0442\u043E\u043A \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D.\r\n\u0411\u0435\u0440\u0438\u0442\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u043B\u043E\u0442\u043A\u0430,
      \u043D\u0435 \u043A\u043B\u0430\u0434\u0438\u0442\u0435 \u0432 \u043D\u0435\u0433\u043E.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
      \u043F\u043E\u0434\u0431\u043E\u0440\u0430 \u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u043D\u044B,
      \u043B\u043E\u0442\u043E\u043A \u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D.\r\n\u041E\u0442\u043A\u0440\u044B\u0442\u0430\u044F\r\n\u041E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043B\u043E\u0442\u043E\u043A\r\n\u0418\u043B\u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      2 \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044F \xAB\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0444\u0430\u043A\u0435\u043B\xBB, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
      \u041E\u043A\u0442\u043E\u0428\u0435\u0444\u0430.\r\n\u0410\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u043E\u0432\u044B\u0439
      \u0441\u043E\u043A\r\nmovavi-grotesque Orange Outline Shadow\r\n\u0417\u0430\u043A\u0430\u0437
      \u2014 \u0432\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E\r\n\u0426\u0435\u043B\u044C
      \u0437\u0430\u043A\u0430\u0437\u0430\r\n\u0425\u043E\u0434\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C\r\n\u0412\u0440\u0435\u043C\u044F
      \u0432\u044B\u0448\u043B\u043E!\r\n\u0412\u0440\u0435\u043C\u044F \u0432\u044B\u0448\u043B\u043E!\r\n\u041F\u0440\u0438\u0445\u0432\u0430\u0442\u043A\u0430\r\n\u0423\u0441\u0442\u0440\u0438\u0446\u0430\r\n\u041F\u0430\u0434
      \u0422\u0430\u0439\r\n\u041E\u0432\u043E\u0449\u0435\u0447\u0438\u0441\u0442\u043A\u0430\r\n\u0412
      \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438\r\n\u041A\u043E\u0440\u0437\u0438\u043D\u0430
      \u0434\u043B\u044F \u043F\u0438\u043A\u043D\u0438\u043A\u0430\r\n\u041A\u043E\u043F\u0438\u043B\u043A\u0430\r\n\u041A\u043E\u043D\u0434\u0438\u0442\u0435\u0440\u0441\u043A\u0438\u0439
